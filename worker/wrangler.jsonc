// OneHub Worker 配置(实现了 PR-2 的 worker/src 之前本文件仅作配置基线)
//
// 使用前:
// 1. 先构建前端: npm run build:web (assets 目录必须存在才能 dev/deploy)
// 2. 创建 KV 并替换占位符: npx wrangler kv namespace create ACCOUNTS / GATE
// 3. 可选密码门: npx wrangler secret put ACCESS_PASSWORD 与 GATE_SECRET
//    (vars 里的 ACCESS_PASSWORD 留空 = 完全公开)
{
  "name": "onehub",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "ACCOUNTS", "id": "<KV_NAMESPACE_ID>" },
    { "binding": "GATE", "id": "<KV_NAMESPACE_ID_2>" }
  ],
  "vars": {
    "ACCESS_PASSWORD": ""
  },
  "observability": {
    "enabled": true
  }
}
